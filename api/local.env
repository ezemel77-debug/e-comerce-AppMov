# Claves secretas para firmar los tokens JWT. En producción deben ser seguras y privadas.
# Se usa un secreto distinto para clientes y otro para administradores,
# así un token de cliente no sirve para rutas de admin y viceversa.
JWT_SECRET_CLIENT=clave_secreta_para_clientes
JWT_SECRET_ADMIN=clave_secreta_para_administradores

# Orígenes permitidos para CORS, separados por comas.
